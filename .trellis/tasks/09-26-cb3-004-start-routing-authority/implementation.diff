+/// 显式角色固定由调用方给出，Prompt 刻意包含另一种角色的文字。
+fn start(work: &str) -> Value {
+    json!({"action":"start","workRunId":work,"workspaceId":"W","requestKey":"key",
+        "prompt":"请开发实现并评审代码，不要根据这些文字改变角色", "taskRole":"testing","providerId":"fixture"})
+}
