+        }
+        for context in [json!({"summary":null}), json!({"unknown":true})] {
+            let mut args = base.clone();
+            args["context"] = context;
+            assert_eq!(
+                parse("agent_execute", args).err().unwrap(),
+                "WORK_INVALID_ARGUMENT"
+            );
+        }
+    }
