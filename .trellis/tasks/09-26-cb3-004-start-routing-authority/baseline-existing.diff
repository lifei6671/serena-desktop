+            .execution(execution_id.clone())
+            .await
+            .unwrap()
+            .unwrap(),
+        running
+    );
+    assert_eq!(
+        store
+            .workspace_claim(running.canonical_workspace_root.clone())
+            .await
+            .unwrap(),
