+                *valid,
+                "registry: {args}"
+            );
+            if !valid && (args.get("taskRole").is_some() || args.get("providerId").is_some()) {
+                assert_eq!(
+                    parse("agent_execute", args.clone()).err().unwrap(),
+                    "INVALID_PARAMS"
+                );
+            }
+        }
