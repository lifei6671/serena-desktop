+                    provider_id: ProviderId::new("not-registered".into()).unwrap(),
+                },
+            ),
+        ] {
+            let mut args = json!({"action":"start","workRunId":"nonexistent","workspaceId":"nonexistent","requestKey":"k","prompt":"p"});
+            args.as_object_mut()
+                .unwrap()
+                .extend(fields.as_object().unwrap().clone());
