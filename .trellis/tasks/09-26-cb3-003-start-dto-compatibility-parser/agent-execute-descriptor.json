          },
          "context": {
            "anyOf": [
              {
                "$ref": "#/$defs/Context"
              },
              {
                "type": "null"
              }
            ]
          },
          "parentExecutionId": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "requestKey": {
            "type": "string"
          },
          "workRunId": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "workRunId",
          "parentExecutionId",
          "requestKey",
          "prompt"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "cancel",
            "type": "string"
          },
          "executionId": {
            "type": "string"
          },
          "workRunId": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "workRunId",
          "executionId"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "resume_pending",
            "type": "string"
          },
          "executionId": {
            "type": "string"
          },
          "workRunId": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "workRunId",
          "executionId"
        ],
        "type": "object"
      }
