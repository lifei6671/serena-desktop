            }
          },
          {
            "required": [
              "taskRole",
              "providerId"
            ]
          }
        ],
        "properties": {
          "action": {
            "const": "start",
            "type": "string"
          },
          "context": {
            "anyOf": [
              {
                "$ref": "#/$defs/Context"
              },
              {
                "type": "null"
              }
            ]
          },
          "prompt": {
            "type": "string"
          },
          "providerId": {
            "minLength": 1,
            "not": {
              "pattern": "[\\u0000-\\u0020\\u007f-\\u009f\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
            },
            "type": "string"
          },
          "requestKey": {
            "type": "string"
          },
          "taskRole": {
            "enum": [
              "development",
              "testing",
              "review",
              "analysis",
              "general"
            ],
            "type": "string"
          },
          "workRunId": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "workRunId",
          "workspaceId",
          "requestKey",
          "prompt"
        ],
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "action": {
            "const": "continue",
